<UserControl x:Class="sistema_gestion_heladeria.Controls.Administrador.InformeVentasControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F8F3ED">

    <UserControl.Resources>
        <Style x:Key="BotonInforme" TargetType="Button">
            <Setter Property="Background" Value="#355C4D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30">

            <!-- Encabezado -->
            <TextBlock Text="Informes de ventas"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="#1D211E"/>

            <TextBlock Text="Consultá las ventas registradas y generá informes por período."
                       FontSize="13"
                       Foreground="#6B6F6A"
                       Margin="0,6,0,24"/>

            <!-- Selección del período -->
            <Border Background="White"
                    BorderBrush="#E2E0D8"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="20">

                <StackPanel>

                    <TextBlock Text="Período del informe"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Margin="0,0,0,15"/>

                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="RbHoy"
                                     Content="Día actual"
                                     IsChecked="True"
                                     Checked="Periodo_Checked"
                                     Margin="0,0,25,0"/>

                        <RadioButton x:Name="RbPersonalizado"
                                     Content="Período personalizado"
                                     Checked="Periodo_Checked"/>
                    </StackPanel>

                    <StackPanel x:Name="PanelFechas"
                                Orientation="Horizontal"
                                Margin="0,20,0,0"
                                IsEnabled="False">

                        <StackPanel Margin="0,0,20,0">
                            <TextBlock Text="Desde"
                                       Margin="0,0,0,6"/>
                            <DatePicker x:Name="DpDesde"
                                        Width="170"/>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Text="Hasta"
                                       Margin="0,0,0,6"/>
                            <DatePicker x:Name="DpHasta"
                                        Width="170"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                Margin="0,22,0,0">

                        <Button x:Name="BtnConsultar"
                                Content="Consultar ventas"
                                Style="{StaticResource BotonInforme}"
                                Click="BtnConsultar_Click"
                                Margin="0,0,12,0"/>

                        <Button x:Name="BtnGuardarPdf"
                                Content="Guardar PDF"
                                Style="{StaticResource BotonInforme}"
                                Background="#FFFFFF"
                                Foreground="#355C4D"
                                BorderBrush="#355C4D"
                                BorderThickness="1"
                                IsEnabled="False"
                                Click="BtnGuardarPdf_Click"/>
                    </StackPanel>

                </StackPanel>
            </Border>

            <!-- Resumen -->
            <TextBlock Text="Resumen del período"
                       FontSize="19"
                       FontWeight="SemiBold"
                       Margin="0,25,0,14"/>

            <UniformGrid Columns="3">

                <Border Background="White"
                        CornerRadius="8"
                        Padding="18"
                        Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Cantidad de ventas"
                                   Foreground="#6B6F6A"/>
                        <TextBlock x:Name="TxtCantidadVentas"
                                   Text="—"
                                   FontSize="23"
                                   FontWeight="Bold"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="White"
                        CornerRadius="8"
                        Padding="18"
                        Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Total registrado"
                                   Foreground="#6B6F6A"/>
                        <TextBlock x:Name="TxtTotalVentas"
                                   Text="—"
                                   FontSize="23"
                                   FontWeight="Bold"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="White"
                        CornerRadius="8"
                        Padding="18">
                    <StackPanel>
                        <TextBlock Text="Ticket promedio"
                                   Foreground="#6B6F6A"/>
                        <TextBlock x:Name="TxtTicketPromedio"
                                   Text="—"
                                   FontSize="23"
                                   FontWeight="Bold"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

            </UniformGrid>

            <!-- Detalle de ventas -->
            <TextBlock Text="Detalle de ventas"
                       FontSize="19"
                       FontWeight="SemiBold"
                       Margin="0,25,0,14"/>

            <DataGrid x:Name="DgVentasInforme"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      Background="White"
                      RowHeight="35"
                      MinHeight="180"
                      MaxHeight="320">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Venta"
                                        Binding="{Binding IdVenta}"
                                        Width="70"/>

                    <DataGridTextColumn Header="Fecha"
                                        Binding="{Binding FechaLocal}"
                                        Width="130"/>

                    <DataGridTextColumn Header="Estado"
                                        Binding="{Binding Estado}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Medio de pago"
                                        Binding="{Binding MedioPago}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Total"
                                        Binding="{Binding Total, StringFormat={}{0:C2}}"
                                        Width="130"/>
                </DataGrid.Columns>

            </DataGrid>

            <TextBlock x:Name="TxtEstadoInforme"
                       Text="Seleccioná un período y consultá las ventas."
                       Foreground="#6B6F6A"
                       Margin="0,14,0,0"
                       TextWrapping="Wrap"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
