<UserControl x:Class="sistema_gestion_heladeria.Controls.repartidorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:sistema_gestion_heladeria.Controls"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="1100"
             Background="#F4F6F9">

    <UserControl.Resources>

        <!-- BOTÓN EN CAMINO -->
        <Style x:Key="BtnCaminoStyle" TargetType="Button">
            <Setter Property="Background" Value="#F59E0B"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- BOTÓN ENTREGADO -->
        <Style x:Key="BtnEntregadoStyle" TargetType="Button">
            <Setter Property="Background" Value="#10B981"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

    </UserControl.Resources>


    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- ENCABEZADO -->
        <Grid Grid.Row="0"
              Margin="0,0,0,10">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>

                <TextBlock Text="Pedidos para entregar"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#1F2937"/>

                <TextBlock Text="Gestión de pedidos del repartidor"
                           FontSize="14"
                           Foreground="#6B7280"
                           Margin="0,5,0,0"/>

            </StackPanel>

            <Button Grid.Column="1"
                    Content="↻ Actualizar"
                    Padding="18,10"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Background="#E05275"
                    Foreground="White"
                    BorderThickness="0"
                    VerticalAlignment="Center"
                    Click="BtnActualizar_Click"/>

        </Grid>


        <!-- AVISO -->
        <Border Grid.Row="1"
                Background="#FFF7ED"
                BorderBrush="#FDBA74"
                BorderThickness="1"
                CornerRadius="8"
                Padding="15"
                Margin="0,5,0,15"
                Visibility="Collapsed">

            <StackPanel Orientation="Horizontal">

                <TextBlock Text="🔔"
                           FontSize="18"
                           Margin="0,0,8,0"/>

                <TextBlock Text="Hay nuevos pedidos de delivery"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="#9A3412"/>

            </StackPanel>

        </Border>


        <!-- DOS COLUMNAS -->
        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>


            <!-- COLUMNA IZQUIERDA -->
            <Border Grid.Column="0"
                    Background="#EEF1F5"
                    CornerRadius="12"
                    Padding="15"
                    Margin="0,0,10,0">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Pedidos para entregar"
                               FontSize="19"
                               FontWeight="Bold"
                               Foreground="#1F2937"
                               Margin="5,0,0,15"/>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">

                        <ItemsControl x:Name="PedidosItemsControl">

                            <ItemsControl.ItemTemplate>

                                <DataTemplate>

                                    <Border Background="White"
                                            CornerRadius="12"
                                            Margin="0,0,0,15"
                                            Padding="20">

                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="8"
                                                              ShadowDepth="2"
                                                              Opacity="0.15"/>
                                        </Border.Effect>

                                        <Grid>

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>


                                            <!-- INFORMACIÓN -->
                                            <StackPanel Grid.Column="0">

                                                <TextBlock Text="{Binding NumeroPedido}"
                                                           FontSize="20"
                                                           FontWeight="Bold"
                                                           Foreground="#1F2937"/>

                                                <TextBlock Text="{Binding ClienteNombre}"
                                                           FontSize="15"
                                                           Margin="0,10,0,0"
                                                           Foreground="#374151"/>

                                                <TextBlock Text="{Binding Direccion}"
                                                           FontSize="14"
                                                           Margin="0,5,0,0"
                                                           Foreground="#6B7280"/>

                                                <TextBlock Text="{Binding Telefono}"
                                                           FontSize="14"
                                                           Margin="0,3,0,10"
                                                           Foreground="#6B7280"/>


                                                <!-- DETALLE -->
                                                <Border Background="#F9FAFB"
                                                        CornerRadius="8"
                                                        Padding="12"
                                                        Margin="0,5,0,10">

                                                    <TextBlock Text="{Binding DetalleFormateado}"
                                                               TextWrapping="Wrap"
                                                               Foreground="#6B7280"/>

                                                </Border>


                                                <!-- ESTADO -->
                                                <StackPanel Orientation="Horizontal">

                                                    <TextBlock Text="Estado:"
                                                               FontWeight="Bold"
                                                               Foreground="#374151"
                                                               VerticalAlignment="Center"/>

                                                    <Border Background="#FEF3C7"
                                                            CornerRadius="15"
                                                            Padding="12,5"
                                                            Margin="10,0,0,0">

                                                        <TextBlock Text="{Binding Estado}"
                                                                   Foreground="#92400E"
                                                                   FontWeight="Bold"
                                                                   FontSize="12"/>

                                                    </Border>

                                                </StackPanel>

                                            </StackPanel>


                                            <!-- BOTONES -->
                                            <StackPanel Grid.Column="1"
                                                        VerticalAlignment="Bottom"
                                                        HorizontalAlignment="Right"
                                                        Margin="20,0,0,0">

                                                <!-- EN CAMINO -->
                                                <Button Content="En camino hacia domicilio"
                                                        Style="{StaticResource BtnCaminoStyle}"
                                                        Tag="{Binding}"
                                                        Click="BtnCamino_Click"/>

                                                <!-- ENTREGADO -->
                                                <Button Content="Entregado"
                                                        Style="{StaticResource BtnEntregadoStyle}"
                                                        Tag="{Binding}"
                                                        Click="BtnEntregado_Click"/>

                                            </StackPanel>

                                        </Grid>

                                    </Border>

                                </DataTemplate>

                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                    </ScrollViewer>

                </Grid>

            </Border>


            <!-- COLUMNA DERECHA -->
            <Border Grid.Column="1"
                    Background="#E8F7F1"
                    CornerRadius="12"
                    Padding="15"
                    Margin="10,0,0,0">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Pedidos entregados"
                               FontSize="19"
                               FontWeight="Bold"
                               Foreground="#065F46"
                               Margin="5,0,0,15"/>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">

                        <ItemsControl x:Name="PedidosEntregadosItemsControl">

                            <ItemsControl.ItemTemplate>

                                <DataTemplate>

                                    <Border Background="White"
                                            CornerRadius="10"
                                            Margin="0,0,0,12"
                                            Padding="15"
                                            BorderBrush="#A7F3D0"
                                            BorderThickness="1">

                                        <StackPanel>

                                            <TextBlock Text="{Binding NumeroPedido}"
                                                       FontSize="17"
                                                       FontWeight="Bold"
                                                       Foreground="#065F46"/>

                                            <TextBlock Text="{Binding ClienteNombre}"
                                                       FontSize="14"
                                                       Foreground="#6B7280"
                                                       Margin="0,5,0,0"/>

                                            <TextBlock Text="{Binding Direccion}"
                                                       FontSize="13"
                                                       Foreground="#6B7280"
                                                       TextWrapping="Wrap"
                                                       Margin="0,3,0,0"/>

                                            <TextBlock Text="✓ Entregado"
                                                       FontWeight="Bold"
                                                       Foreground="#065F46"
                                                       Margin="0,8,0,0"/>

                                        </StackPanel>

                                    </Border>

                                </DataTemplate>

                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                    </ScrollViewer>

                </Grid>

            </Border>

        </Grid>

    </Grid>

</UserControl>